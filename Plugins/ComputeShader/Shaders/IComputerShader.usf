#include "/Engine/Public/Platform.ush"

// 必须和 C++ 端 FCurveSegmentGPU 完全一致（32B / 8 floats）。
struct FCurveSegment
{
	float4 Endpoints; // x0, y0, x1, y1
	uint CurveIndex;
	uint _Pad0;
	uint _Pad1;
	uint _Pad2;
};

RWTexture2D<float4> RenderTarget;
Buffer<float> LineDrawDesc;
StructuredBuffer<FCurveSegment> LineData;
Buffer<uint> BucketRanges;
Buffer<float4> CurveColors;

#define TILE_HEIGHT 64

float DistanceToSegment(float2 Pixel, float2 Start, float2 End)
{
	float2 Segment = End - Start;
	float SegmentLengthSquared = max(dot(Segment, Segment), 0.0001f);
	float T = saturate(dot(Pixel - Start, Segment) / SegmentLengthSquared);
	float2 Closest = Start + Segment * T;
	return length(Pixel - Closest);
}

void AccumulateSegmentDistance(
	inout float MinDistance,
	inout uint BestCurveIndex,
	float2 Pixel,
	float2 SegmentStart,
	float2 SegmentEnd,
	uint CurveIndex,
	float BoundsExpand)
{
	float MinY = min(SegmentStart.y, SegmentEnd.y) - BoundsExpand;
	float MaxY = max(SegmentStart.y, SegmentEnd.y) + BoundsExpand;
	if (Pixel.y < MinY || Pixel.y > MaxY)
	{
		return;
	}

	float Distance = DistanceToSegment(Pixel, SegmentStart, SegmentEnd);
	if (Distance < MinDistance)
	{
		MinDistance = Distance;
		BestCurveIndex = CurveIndex;
	}
}

float4 LoadCurveColor(uint CurveIndex, uint CurveCount)
{
	uint SafeCurveIndex = min(CurveIndex, max(CurveCount, 1u) - 1u);
	return CurveColors[SafeCurveIndex];
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void IComputerShader(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	float Width = LineDrawDesc[0];
	float Height = LineDrawDesc[1];
	uint TileCountY = max(uint(LineDrawDesc[2]), 1u);
	uint CurveCount = max(uint(LineDrawDesc[3]), 1u);
	float LineWidth = 1.0f;
	float HalfWidth = LineWidth * 0.5f;
	float AntiAliasWidth = 1.0f;

	uint2 PixelCoord = DispatchThreadId.xy;

	if (PixelCoord.x >= Width || PixelCoord.y >= Height || Width < 1.0f)
	{
		return;
	}

	float2 Pixel = float2((float)PixelCoord.x + 0.5f, (float)PixelCoord.y + 0.5f);
	float MinDistance = 100000.0f;
	uint BestCurveIndex = 0u;
	float BoundsExpand = HalfWidth + AntiAliasWidth;

	uint YTile = PixelCoord.y / TILE_HEIGHT;
	uint CellIndex = PixelCoord.x * TileCountY + YTile;
	uint RangeBase = CellIndex * 2u;
	uint SegmentOffset = BucketRanges[RangeBase];
	uint SegmentCount = BucketRanges[RangeBase + 1u];

	for (uint SegmentIndex = 0u; SegmentIndex < SegmentCount; ++SegmentIndex)
	{
		FCurveSegment Segment = LineData[SegmentOffset + SegmentIndex];
		float2 SegmentStart = Segment.Endpoints.xy;
		float2 SegmentEnd = Segment.Endpoints.zw;
		uint CurveIndex = min(Segment.CurveIndex, CurveCount - 1u);
		AccumulateSegmentDistance(MinDistance, BestCurveIndex, Pixel, SegmentStart, SegmentEnd, CurveIndex, BoundsExpand);
	}

	float Alpha = 1.0f - smoothstep(HalfWidth, HalfWidth + AntiAliasWidth, MinDistance);

	float4 BackgroundColor = float4(0.0f, 0.0f, 0.5f, 0.5f);
	float4 LineColor = LoadCurveColor(BestCurveIndex, CurveCount);
	RenderTarget[PixelCoord] = lerp(BackgroundColor, LineColor, Alpha * LineColor.a);
}
